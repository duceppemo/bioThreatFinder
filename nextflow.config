// bioThreatFinder - metagenomic detection of high-consequence pathogens
// Domain packs (human / animal / plant) keep databases scoped instead of monolithic.

manifest {
    name            = 'bioThreatFinder'
    author          = 'duceppemo'
    description     = 'Two-stage metagenomic screening and in-silico confirmation of high-consequence pathogens'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
    mainScript      = 'main.nf'
}

params {
    // ---- input / output ----
    input               = null          // samplesheet CSV: sample,platform,fastq_1,fastq_2,role
    outdir              = 'results'

    // ---- domain pack ----
    pack                = 'human'       // human | animal | plant
    packs_dir           = "${projectDir}/packs"

    // ---- database roots ----
    // Deliberate split. db_root holds large SHARED, pre-existing, read-only
    // resources (taxdump, sylph GTDB sketch, nt) on the 36 TB volume. btf_db holds
    // project-owned artifacts on fast NVMe, which matters a great deal for k-mer
    // index load times - KrakenUniq and Metabuli indexes are read-heavy.
    db_root             = '/media/36tb/db'
    btf_db              = '/media/8tb/bioThreatFinder'
    // PINNED, dated snapshot. The watchlist resolves against this and the k-mer
    // index is built from it; if those two ever differ, taxids disagree and every
    // watchlist lookup misses - an empty result indistinguishable from a clean
    // negative. The shared /media/36tb/db/taxdump was 6.5 months stale (288,764
    // taxids short, 2,581 descendant nodes missing inside watchlist clades) and is
    // used by other work on this machine, so it is left untouched.
    taxdump             = "${params.btf_db}/taxdump/2026-09-29"

    // ---- stage 1: broad screen (multi-classifier) ----
    // KRAKEN2 IS PRIMARY (decisions.md D2, a reversal). Its
    // --report-minimizer-data gives distinct-minimizer counts and a duplicity
    // ratio - the same HyperLogLog code KrakenUniq uses, at the same default
    // precision, counting minimizers rather than k-mers - from an index we build
    // anyway. KrakenUniq is an OPT-IN second opinion (skip_krakenuniq defaults to
    // true; enable with `--skip_krakenuniq false`, not by omitting the flag).
    // Metabuli is now ALSO OPT-IN (skip_metabuli defaults to true; enable with
    // `--skip_metabuli false`). It was on by default on the strength of its design
    // argument - amino-acid k-mers see a divergent agent that nucleotide k-mers miss.
    // Measured, it has changed ZERO decisions on every scenario it has been run
    // against (D15, docs/benchmarking.md): identical findings.tsv on the identity-
    // matched LoD batch, and identical again on the divergent_* pair the bake-off
    // table nominated as where its value should appear - where both arms assign all
    // 3,992 spiked reads to the same taxon, read for read. Cost is ~22x Kraken2's
    // CPU per sample and a 110 GB index. The design argument is not refuted, because
    // its one untested case is an agent ABSENT from the index, which cannot be
    // simulated from a database; so the arm is kept and defaulted off rather than
    // removed. Turn it on deliberately, for a novel-agent question.
    // Bracken gives abundance. Sylph gives ANI-based containment. See
    // bin/parse_screen.py for why any-classifier OR is the right combining rule
    // rather than consensus.
    // Database paths: pack.yaml is the source of truth and these are OVERRIDES.
    // Leaving them null means "use the pack's value"; setting one on the command
    // line wins. They were previously given concrete defaults, which silently lost
    // to pack.yaml and made --krakenuniq_db and friends no-ops - a documented
    // parameter that does nothing is worse than no parameter.
    krakenuniq_db       = null   // only used when --skip_krakenuniq false
    // VERIFY: the preload flag name differs between KrakenUniq versions
    // (--preload vs --preload-size <N>G). Left as a configurable string rather
    // than a guess baked into the module: a wrong flag here either fails loudly
    // or, worse, is ignored and quietly costs an order of magnitude in runtime.
    // Check `krakenuniq --help` once installed and set accordingly.
    krakenuniq_preload_args = '--preload'
    // Classify-time HyperLogLog precision, NOT a build parameter - the sketches
    // are built while reading each sample. Range 10-18; relative error is about
    // 1.04/sqrt(2^p), so p=12 gives ~1.6%. Stage 1 uses cardinality as a
    // threshold gate where genuine separation is ~10x, so 1.6% changes no call
    // while p=18 would cost 64x the sketch memory across tens of thousands of
    // taxa. Raise it only if cardinality becomes a continuous statistic (i.e. if
    // the empirical-null work starts consuming it directly).
    // Left null so the value recorded at build time in
    // <db>/btf_classify_defaults.env wins and build/query cannot drift.
    krakenuniq_hll_precision = null
    metabuli_db         = null
    kraken2_db          = null
    // bracken_dist was declared here and read by NOTHING. BRACKEN takes file(k2_db_path)
    // (main.nf), so a separate k-mer distribution could never be applied and setting this
    // was a silent no-op. Removed; supporting it means a new process input.
    // Load the Kraken2 hash with mmap instead of reading it into anonymous memory.
    //
    // The hash is 123.5 GB. Read into RAM it costs that much PER CONCURRENT TASK and is
    // unreclaimable; mmap'd it is file-backed, so N tasks share ONE copy in page cache and
    // the kernel can evict it under pressure instead of something being killed. On
    // 2026-10-02 a single 123.5 GB anonymous load drove user-slice pressure to 87.72% and
    // systemd-oomd killed the running build, gnome-shell and five tmux scopes.
    //
    // Measured on this box (100k pairs, 30 Mbp, same index): 30.7 s with a cold page
    // cache, 1.7 s once warm. So the mmap penalty is a one-off, PROVIDED the index fits
    // in cache. Set false on a machine where it does not - random access across 123 GB of
    // uncached NVMe is far slower than loading it once.
    kraken2_memory_mapping = true
    sylph_db            = null
    // sylph_viral_db was declared here and read by NOTHING. SYLPH_PROFILE uses
    // params.sylph_db / pack.screen.sylph_db only (main.nf), so pointing this at an IMG/VR
    // sketch silently searched nothing: a viral containment arm that looked configured and
    // did not exist. Removed rather than left as a parameter that does nothing - wiring a
    // second sylph database is a real change to the process, not a config line.
    // KrakenUniq is now OPT-IN rather than primary. Kraken2's --report-minimizer-data
    // columns are literally KrakenUniq's HyperLogLog implementation (same author,
    // same default precision p=12) counting minimizers instead of k-mers, and the one
    // published comparison (Oskolkov 2026) finds comparable F1 once the threshold is
    // shifted by the 2-3x that subsampling implies. KrakenUniq has had no commit since
    // December 2023 while Kraken2 ships regularly. If you do want it as a second
    // opinion, a prebuilt index exists - do not build one.
    skip_krakenuniq     = true
    skip_metabuli       = true   // OPT-IN: see the note above and D15
    skip_kraken2        = false
    skip_sylph          = false
    skip_host_depletion = false

    // Distinct-k-mer quality. FLAG-ONLY at stage 1 by design: stage 1 stays
    // permissive and stage 2 discriminates. Dropping candidates here would undo
    // that, and a flag that reaches scoring is more useful than a silent vanish.
    // Calibrated starting point, not a guess. Oskolkov 2026 (Front Microbiol,
    // doi:10.3389/fmicb.2026.1603339) is the only published comparison of these
    // filters and finds the optimum around 1,000 unique k-mers for KrakenUniq and
    // 2,000-3,000 DISTINCT MINIMIZERS for Kraken2 - minimizers subsample roughly one
    // per 5-base window, which is where the 2-3x offset comes from. An earlier value
    // of 150 here was over ten times too permissive.
    //
    // Thresholds are also depth-dependent (the KrakenUniq paper reports roughly
    // +2,000 unique k-mers per million reads), so this MUST be recalibrated on your
    // own panel and depth. That is what the benchmark harness is for.
    min_distinct_kmers  = 2000
    max_kmer_dup        = 25.0

    // ---- QC ----
    sr_min_len          = 50
    sr_min_qual         = 20
    lr_min_len          = 200
    lr_min_qual         = 9

    // ---- stage 1 candidate thresholds (deliberately permissive; stage 2 does the filtering) ----
    min_screen_reads    = 10            // reads assigned at/below a watchlist taxon
    // (min_screen_frac was declared here and corresponded to no option on any script.
    //  Removed rather than left as a knob that does nothing.)

    // ---- stage 2 confirmation thresholds: OVERRIDES, not defaults ----
    //
    // packs/<pack>/pack.yaml is the source of truth, because a pack is data and a
    // threshold is part of the pack's meaning. These exist so a profile or a CLI flag
    // can relax a gate WITHOUT editing the pack, and null means "use the pack value".
    //
    // They were previously set to concrete numbers here and passed to NO process. Two
    // consequences: `-profile test` set min_unique_reads=1 / min_breadth=0.0 to relax
    // stage 2, both were ignored, and the tiny test input produced zero confirmations
    // that read as a clean negative; and the numbers here disagreed with pack.yaml
    // (min_breadth 0.10 vs 0.005) while --help printed these, so the documented value
    // was not the applied one. score_evidence.py now rejects an unknown key outright.
    min_unique_reads    = null          // MAPQ-filtered, primary, non-dup reads on target
    min_breadth         = null          // fraction of reference bases with depth >= 1
    max_depth_cv        = null          // CV of per-base depth; high CV = piled on one locus
    min_read_identity   = null          // mean aligned identity; pack.yaml sets it per platform AND group
    mapq_min            = 10

    // resolve_watchlist.py's freshness check is opt-in (--require-fresh-taxdump), and
    // the pipeline never passed it - so README and D8's claim that "guards now REFUSE
    // a snapshot >90 days old" described a documented invocation, not this pipeline.
    // Now enforced. params.taxdump is pinned, so this becomes live as that pin ages.
    max_taxdump_age_days = 90

    // Host-containing FASTQs are NOT published by default. fastp's trimmed reads are
    // pre-depletion and carry the specimen's full human content; a clinical-adjacent
    // pipeline should not copy those into results/ unasked. Set true if you need them.
    publish_reads        = false

    // ---- marker tier (stage 2b) ----
    // For many taxa the chromosome is not the actionable signal, so marker
    // evidence gates promotion to confirmed_in_silico. See packs/*/markers.tsv
    // and marker_rules.yaml.
    skip_markers        = false
    skip_marker_hmm     = false     // the HMM tier is what catches novel/divergent alleles
    hmm_min_bits        = 25.0      // now actually passed to marker_evidence.py
    // The protein tier's own hit cutoff.
    marker_aa_evalue    = 1e-5
    // A LOOSER cutoff used only to choose which reads get a profile (HMM) search.
    // The HMM tier used to receive exactly the reads that already cleared
    // marker_aa_evalue, so it could only confirm a subset of what the protein tier had
    // found and a read divergent enough to need a profile never reached hmmsearch -
    // removing the one capability that tier exists for. One mmseqs search serves both;
    // the cost is in the search, not the cutoff.
    marker_hmm_prefilter_evalue = 1e-2

    // DEPTH-AWARE MARKER PRESENCE. A catalogue min_coverage of 0.80 silently requires
    // >= 1.6x depth on the locus (Lander-Waterman: breadth = 1 - e^-d), so below that
    // the threshold is unreachable however real the organism is, and the marker is
    // recorded ABSENT. On the plumbing positive control that held a correct Y. pestis
    // detection at `screened_only`: 0.34x mean depth, ypest_pmt1_caf1 with 13 reads at
    // 99.8% identity and 0.323 observed breadth against a 0.80 floor.
    //
    // Where the floor IS reachable it still applies unchanged. Where it is not, a
    // marker may qualify on being as covered as the depth permits, with a minimum read
    // count and the FULL identity requirement - identity is never relaxed, because it
    // is what separates a real locus from a mismapped read.
    marker_min_low_depth_reads          = 5
    marker_low_depth_breadth_fraction   = 0.60

    // Bracken read-length model. build_kraken2_db.sh builds distributions for 100,
    // 150 and 250 bp. This was READ by detect.nf and never declared, so a 100 bp or
    // 250 bp run silently used the 150 bp model.
    bracken_readlen     = 150

    // ---- control / contamination handling ----
    control_ratio       = 5.0           // sample must exceed control by this fold (normalised) to stand

    // ---- reporting ----
    lab_name            = 'Unspecified laboratory'
    run_id              = null

    // ---- resources ----
    max_cpus            = 64
    max_memory          = '400.GB'
    max_time            = '72.h'

    // ---- misc ----
    // Timestamp for the per-run report filenames. It lives in params because the
    // strict config parser (Nextflow 24+) rejects top-level `def` declarations.
    trace_timestamp     = new java.util.Date().format('yyyyMMdd-HHmmss')
    publish_dir_mode    = 'copy'
    // validate_params was declared here and read by NOTHING - no plugins block, no
    // nf-schema/nf-validation, no nextflow_schema.json. Nextflow accepts unknown --params
    // silently, so `--skip_metabulli false` leaves skip_metabuli at its default and the arm
    // stays off with no message. The flag implied a protection that did not exist, which is
    // worse than no flag: it is removed rather than left as reassurance. Restoring the
    // protection means adding nf-schema and a schema file, not re-adding this line.
    help                = false
}

profiles {
    conda {
        conda.enabled          = true
        conda.useMicromamba    = false
        conda.cacheDir         = "${System.getenv('HOME')}/.nextflow-conda"
        docker.enabled         = false
        singularity.enabled    = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        conda.cacheDir         = "${System.getenv('HOME')}/.nextflow-conda"
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
    }
    // Tuned for this workstation: 64 cores / 503 GB RAM.
    workstation {
        params.max_cpus        = 60
        params.max_memory      = '420.GB'
        process.executor       = 'local'
    }
    test {
        includeConfig 'conf/test.config'
    }
    debug {
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
        dumpHashes             = true
    }
}

includeConfig 'conf/base.config'

// Reports. One timestamped set per run, so a benchmark batch does not overwrite
// its own provenance.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline-${params.trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report-${params.trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace-${params.trace_timestamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag-${params.trace_timestamp}.html" }
