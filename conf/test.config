/*
 * Minimal smoke-test profile. Uses tiny inputs and skips the heavy steps so the
 * channel wiring can be exercised in minutes rather than hours.
 */
params {
    max_cpus            = 4
    max_memory          = '12.GB'
    max_time            = '2.h'
    input               = "${projectDir}/tests/data/samplesheet_test.csv"
    pack                = 'human'
    skip_host_depletion = true   // no host index in CI
    skip_sylph          = true   // 14 GB GTDB sketch is not a test dependency
    min_screen_reads    = 1
    min_unique_reads    = 1
    min_breadth         = 0.0
    lab_name            = 'Test'
}
