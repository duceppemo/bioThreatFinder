/*
 * Minimal smoke-test profile: tiny inputs, heavy steps skipped, so the channel wiring can
 * be exercised in minutes rather than hours.
 *
 * WHAT THIS PROFILE CANNOT DO, STATED HERE RATHER THAN DISCOVERED
 * ---------------------------------------------------------------
 * It is not a self-contained test and cannot be made into one by adding a samplesheet.
 * Stage 1 needs a classifier database, stage 2 maps against the reference pack, and the
 * marker tier needs the marker database - together 60 GB that cannot live in a git
 * repository. `tests/data/samplesheet_test.csv` is therefore a HEADER ONLY, and running
 * this profile on a machine with no databases stops at the first process that needs one.
 *
 * That used to be a GREEN RUN that analysed nothing, which is this project's recurring
 * failure shape: an empty samplesheet produced an empty result indistinguishable from a
 * clean negative. An empty samplesheet is now a hard error (main.nf), and the message
 * below says what the profile actually needs.
 *
 * THE TEST THAT DOES RUN ANYWHERE is the regression suite: `python3
 * tests/test_pipeline.py`, 400+ fixture-driven checks, offline, no databases, ~30 s. That
 * is what CI runs and what pins the behaviours in docs/verification.md. This profile is
 * for exercising the WORKFLOW once the databases exist.
 */
params {
    max_cpus            = 4
    max_memory          = '12.GB'
    max_time            = '2.h'
    input               = "${projectDir}/tests/data/samplesheet_test.csv"
    pack                = 'human'
    skip_host_depletion = true   // no host index is assumed present
    skip_sylph          = true   // the pack sketch is a build artifact, not a fixture
    min_screen_reads    = 1
    min_unique_reads    = 1
    min_breadth         = 0.0
    lab_name            = 'Test'
}

// The launch-time notice that used to live here is in main.nf: Nextflow 26's strict
// config syntax accepts no statements in a config file, only assignments and blocks.
