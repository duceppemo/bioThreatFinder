// Resource labels. Kraken2 is the memory hog; everything else is modest.

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1) return params.max_memory as nextflow.util.MemoryUnit
            return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1) return params.max_time as nextflow.util.Duration
            return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj as int, params.max_cpus as int) } catch (all) { return obj }
    }
}

process {
    cpus   = { check_max(1,      'cpus'   ) }
    memory = { check_max(6.GB  * task.attempt, 'memory') }
    time   = { check_max(4.h   * task.attempt, 'time'  ) }

    errorStrategy = { task.exitStatus in [104,134,137,138,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { check_max(1,                  'cpus'   ) }
        memory = { check_max(4.GB * task.attempt, 'memory') }
    }
    withLabel: process_low {
        cpus   = { check_max(4,                   'cpus'   ) }
        memory = { check_max(8.GB  * task.attempt, 'memory') }
    }
    withLabel: process_medium {
        cpus   = { check_max(12,                  'cpus'   ) }
        memory = { check_max(32.GB * task.attempt, 'memory') }
    }
    withLabel: process_high {
        cpus   = { check_max(24,                   'cpus'   ) }
        memory = { check_max(64.GB * task.attempt, 'memory') }
    }
    // Kraken2 loads the whole hash table into RAM. PlusPF is ~70 GB.
    withLabel: process_hugemem {
        cpus   = { check_max(16,                    'cpus'   ) }
        memory = { check_max(120.GB * task.attempt, 'memory') }
        time   = { check_max(8.h,                   'time'   ) }
    }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
    ]
}
