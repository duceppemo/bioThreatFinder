/*
 * Resource labels.
 *
 * Nextflow 24+ strict config syntax forbids function declarations in config
 * files, which retires the old nf-core `check_max()` helper. `resourceLimits`
 * replaces it and does the job better: Nextflow clamps every request to the
 * ceiling itself, including on retry, so a doubling retry can no longer ask for
 * more than the machine has.
 *
 * The k-mer classifiers are the memory consumers here. Each gets its own label so
 * an HPC profile can size them independently rather than having them inherit a
 * Kraken2-shaped request.
 */

process {
    // Nextflow's default task shell is `bash -ue`, which does NOT include pipefail, so a
    // pipeline's exit status is its LAST command's alone. MINIMAP2_HOST_DEPLETE is
    // `minimap2 | tee >(flagstat) | samtools fastq`: if minimap2 dies partway (OOM, a
    // truncated host index) samtools fastq consumes the partial stream, exits 0, the task
    // SUCCEEDS, and the dehosted FASTQ is silently truncated. That gap predates
    // <outdir>/qc/host_depletion.tsv, but that file now publishes statistics computed over
    // this very pipe, so a partial stream would be reported as a sample's depletion
    // efficiency rather than failing the run.
    shell = ['/bin/bash', '-euo', 'pipefail']

    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    cpus   = 1
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Retry only on the exit codes that indicate a resource problem; anything
    // else is a real error and should surface immediately rather than being
    // retried into a confusing failure three attempts later.
    errorStrategy = { task.exitStatus in [104, 134, 137, 138, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 12
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = 24
        memory = { 64.GB * task.attempt }
    }

    // Kraken2 over the PlusPF index built 2026-10-02: hash.k2d is 123.5 GB, NOT the ~70 GB
    // this once assumed - so the old 120.GB was below the file the task must map, and
    // 420.GB/120.GB admitted THREE concurrent tasks, ~370 GB of unreclaimable memory.
    //
    // With params.kraken2_memory_mapping (the default) the index is file-backed and shared
    // between tasks, so the figure below is a per-task working set, not a copy of the hash.
    // maxForks is a backstop: it bounds concurrency even if this memory figure is later
    // raised or the profile's max_memory grows. Set kraken2_memory_mapping=false and this
    // must go back above 123.5 GB, with maxForks staying at 1.
    withLabel: process_hugemem {
        cpus     = 16
        memory   = { 24.GB * task.attempt }
        time     = { 8.h * task.attempt }
        maxForks = 2
    }
    // KrakenUniq holds the index plus per-taxon HyperLogLog sketches, so it needs
    // more headroom than Kraken2 over the same library set.
    withLabel: process_krakenuniq {
        cpus   = 24
        memory = { 200.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    // Metabuli's index is larger again, and it does amino-acid translation on top.
    withLabel: process_metabuli {
        cpus   = 24
        memory = { 180.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    // TWO DESTINATIONS, BECAUSE THE SOFTWARE VERSION RECORD DID NOT EXIST.
    //
    // 20 processes emit versions.yml and the single rule that used to be here returned
    // null for every one, so nothing collected them and nothing published them: a run
    // left no record of which tool versions produced its findings. For output meant to
    // be defensible - and where a version difference is a live hazard, the kraken2
    // 2.0.8-beta that silently lacks --report-minimizer-data, or an index that must be
    // read by the same version that built it - that is the one piece of provenance that
    // cannot be reconstructed afterwards. One file per process, named after it.
    publishDir = [
        [
            path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            // DO NOT PUBLISH READS THAT STILL CONTAIN HOST SEQUENCE.
            //
            // This blanket rule dropped only versions.yml, and FASTP declares
            // ${meta.id}.trim*.fastq.gz as an output - so PRE-DEPLETION trimmed reads,
            // full human content, were copied into results/fastp/ on every run of a
            // pipeline whose own pack comment says "Human reads are the bulk of most
            // clinical specimens; keep them out of the published output by default".
            // pack.yaml's host.retain_host_reads key was inert. Competitive BAMs are
            // target-only and stay published; FASTQs are opt-in via --publish_reads.
            saveAs: { fn ->
                if (fn.equals('versions.yml')) return null
                if (!params.publish_reads && fn ==~ /.*\.f(ast)?q(\.gz)?$/) return null
                return fn
            },
        ],
        [
            path: { "${params.outdir}/pipeline_info/versions" },
            mode: params.publish_dir_mode,
            pattern: 'versions.yml',
            saveAs: { "${task.process.tokenize(':')[-1].toLowerCase()}.yml" },
        ],
    ]
}
