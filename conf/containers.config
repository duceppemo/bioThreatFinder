// GENERATED by scripts/sync_container_specs.py - do not edit.
//
// Loaded by the docker, podman, singularity and apptainer profiles. Each image
// is built from envs/process/<name>.yml, which carries the SAME pins as the
// process's conda directive - see scripts/sync_container_specs.py for why this
// file is generated rather than maintained.
//
// The tag is the pipeline version from the manifest, written in literally, so an
// image can never be newer or older than the pipeline that asks for it and no
// profile combination can resolve it to `latest`.
//
// container_prefix is a PREFIX and not a registry, so it can be overridden to
// nothing useful-looking: `--container_prefix biothreatfinder-` runs images built
// locally with containers/Dockerfile, and a registry path runs them from a
// mirror. A registry variable with a `/` joined on cannot express the local case.

params {
    container_prefix = 'ghcr.io/duceppemo/biothreatfinder-'
}

process {
    withName: 'RESOLVE_WATCHLIST' {
        container = "${params.container_prefix}python:0.4.1"
    }
    withName: 'KRAKEN2' {
        container = "${params.container_prefix}kraken2:0.4.1"
    }
    withName: 'BRACKEN' {
        container = "${params.container_prefix}bracken:0.4.1"
    }
    withName: 'SYLPH_PROFILE' {
        container = "${params.container_prefix}sylph:0.4.1"
    }
    withName: 'KRAKENUNIQ' {
        container = "${params.container_prefix}krakenuniq:0.4.1"
    }
    withName: 'METABULI' {
        container = "${params.container_prefix}metabuli:0.4.1"
    }
    withName: 'PARSE_SCREEN' {
        container = "${params.container_prefix}python:0.4.1"
    }
    withName: 'MINIMAP2_COMPETITIVE' {
        container = "${params.container_prefix}minimap2-samtools:0.4.1"
    }
    withName: 'COVERAGE_STATS' {
        container = "${params.container_prefix}python-samtools:0.4.1"
    }
    withName: 'SCORE_EVIDENCE' {
        container = "${params.container_prefix}python:0.4.1"
    }
    withName: 'MAKE_REPORT' {
        container = "${params.container_prefix}python:0.4.1"
    }
    withName: 'MARKER_ALIGN_NT' {
        container = "${params.container_prefix}minimap2-samtools:0.4.1"
    }
    withName: 'MARKER_SEARCH_AA' {
        container = "${params.container_prefix}mmseqs2-seqkit:0.4.1"
    }
    withName: 'MARKER_SEARCH_HMM' {
        container = "${params.container_prefix}hmmer-seqkit:0.4.1"
    }
    withName: 'MARKER_EVIDENCE' {
        container = "${params.container_prefix}python-samtools:0.4.1"
    }
    withName: 'PAVIAN_EXPORT' {
        container = "${params.container_prefix}python:0.4.1"
    }
    // PAVIAN_REPORT: no container - Pavian installs from GitHub; off by default, host-only
    withName: 'FASTP' {
        container = "${params.container_prefix}fastp:0.4.1"
    }
    withName: 'CHOPPER' {
        container = "${params.container_prefix}chopper:0.4.1"
    }
    withName: 'MINIMAP2_HOST_DEPLETE' {
        container = "${params.container_prefix}minimap2-python-samtools:0.4.1"
    }
    withName: 'SEQKIT_STATS' {
        container = "${params.container_prefix}seqkit:0.4.1"
    }
}

